{
  "compilerOptions": {
    /* Salida del compilador */
    "outDir": "dist",
    "rootDir": "./",

    /* Target y módulo */
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    /* Checks */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Interoperabilidad con require/import */
    "esModuleInterop": true,

    /* Opciones útiles */
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
